+static void
+encode_frame(ChartMovie *m, AVFrame *frame)
+{
+    if (avcodec_send_frame(m -> ctxt, frame) < 0)
+        return;
+    while (avcodec_receive_packet(m -> ctxt, m -> pkt) >= 0) {
+        fwrite(m -> pkt -> data, 1, m -> pkt -> size, m -> fp);
+        av_packet_unref(m -> pkt);
+    }
+}
