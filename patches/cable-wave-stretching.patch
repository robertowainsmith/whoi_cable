+/*
+ * Kinematic stretching (cable-free modification).
+ *
+ * Linear (Airy) wave kinematics are defined only up to the mean water level.
+ * Stock Cable sets the wave velocity and acceleration to zero anywhere above
+ * it. A body riding the surface then feels no orbital flow on crests but the
+ * full flow in troughs, so its time-averaged drag pushes it up-wave.
+ * Stretching extends the kinematics up to the instantaneous surface:
+ *
+ *   wheeler   (default) the water column from the seabed to the
+ *             instantaneous surface, depth + eta, is mapped linearly onto
+ *             the linear-theory column, 0 to depth:
+ *                 x_s = x * depth / (depth + eta)
+ *             x is height above the seabed (Cable's vertical coordinate).
+ *   vertical  kinematics are unchanged below the mean water level and held
+ *             at their mean-water-level values above it: x_s = min(x, depth).
+ *   none      stock Cable: zero above the mean water level.
+ *
+ * With wheeler or vertical, points above the instantaneous surface are in
+ * air and get zero kinematics. The linear expressions are then evaluated at
+ * x_s, for accelerations as well as velocities.
+ *
+ * The method is chosen with the environment variable CABLE_STRETCHING
+ * (wheeler, vertical or none), read once per run and reported on stderr.
+ */
+
+typedef enum { StretchNone, StretchVertical, StretchWheeler } StretchMethod;
+
+static int stretch_method = -1;
+
+static int GetStretchMethod (void)
+{
+   const char *s;
+
+   if (stretch_method >= 0)
+      return stretch_method;
+
+   s = getenv ("CABLE_STRETCHING");
+   if (s == NULL || *s == '\0' || strcasecmp (s, "wheeler") == 0)
+      stretch_method = StretchWheeler;
+   else if (strcasecmp (s, "vertical") == 0)
+      stretch_method = StretchVertical;
+   else if (strcasecmp (s, "none") == 0)
+      stretch_method = StretchNone;
+   else
+      ExitErr ("CABLE_STRETCHING must be wheeler, vertical or none, not \"%s\"", s);
+
+   fflush (stdout);	/* keep the message on its own line in a shared log */
+   fprintf (stderr, "cable-free: wave kinematics with %s\n",
+            stretch_method == StretchWheeler  ? "Wheeler stretching" :
+            stretch_method == StretchVertical ? "vertical stretching" :
+            "no stretching (stock Cable: zero above mean water level)");
+   return stretch_method;
+}
+
+/*
+ * Free-surface elevation at (y, z), summed over every wave component that
+ * WaveParticleVelocity uses: the y-direction set always, the z-direction set
+ * only for 3D calls (use_z). Velocity and acceleration are evaluated at the
+ * same point and time in turn, so the last value is cached.
+ */
+static double StretchElevation (double t, double y, double z, int use_z)
+{
+   static int     cached = 0;
+   static int     last_use_z;
+   static double  last_t, last_y, last_z, last_eta;
+   double         factor;
+   double         eta = 0.0;
+   double         om, k;
+   int            i;
+
+   if (cached && t == last_t && y == last_y && z == last_z
+              && use_z == last_use_z)
+      return last_eta;
+
+   if (analysis -> ramp_time && t < analysis -> ramp_time)
+      factor = t / analysis -> ramp_time;
+   else
+      factor = 1.0;
+
+   if (environment -> input_type == Regular) {
+      for (i = 0 ; i < environment -> num_components [2] ; i++) {
+         k  = environment -> k [2][i];
+         om = environment -> omega [2][i];
+         eta += factor*environment -> amplitude [2][i]
+                *cos(k*y - om*t - environment -> phase [2][i]);
+      }
+      if (use_z) {
+         for (i = 0 ; i < environment -> num_components [3] ; i++) {
+            k  = environment -> k [3][i];
+            om = environment -> omega [3][i];
+            eta += factor*environment -> amplitude [3][i]
+                   *cos(k*z - om*t - environment -> phase [3][i]);
+         }
+      }
+   }
+   else if (environment -> input_type == Random) {
+      if (!initialized_random)
+         InitializeRandom ( );
+
+      if (environment -> amplitude [2][0]) {
+         om = om_0;
+         for (i = 0 ; i < nfreq ; i++) {
+            eta += factor*rand_a [i][2]*cos(rand_k [i]*y - om*t - rand_phi [i]);
+            om += d_om;
+         }
+      }
+      if (use_z && environment -> amplitude [3][0]) {
+         om = om_0;
+         for (i = 0 ; i < nfreq ; i++) {
+            eta += factor*rand_a [i][3]*cos(rand_k [i]*z - om*t - rand_phi [i]);
+            om += d_om;
+         }
+      }
+   }
+
+   cached = 1;
+   last_t = t; last_y = y; last_z = z; last_use_z = use_z;
+   last_eta = eta;
+
+   return eta;
+}
+
+/*
+ * Height above the seabed at which to evaluate the linear kinematics for a
+ * point at height x. Returns 0 if the point is out of the water (below the
+ * seabed, or above the surface the method uses), otherwise 1 with *xs set.
+ */
+static int StretchHeight (double t, double x, double y, double z,
+                          int use_z, double *xs)
+{
+   double  h = environment -> depth;
+   double  eta;
+
+   if (x < 0)
+      return 0;
+
+   switch (GetStretchMethod ( )) {
+   case StretchNone:
+      if (x > h)
+         return 0;
+      *xs = x;
+      return 1;
+
+   case StretchVertical:
+      eta = StretchElevation (t, y, z, use_z);
+      if (x > h + eta)
+         return 0;
+      *xs = (x < h) ? x : h;
+      return 1;
+
+   default:	/* Wheeler */
+      eta = StretchElevation (t, y, z, use_z);
+      if (x > h + eta || h + eta <= 0.0)
+         return 0;
+      *xs = x*h/(h + eta);
+      return 1;
+   }
+}
+
