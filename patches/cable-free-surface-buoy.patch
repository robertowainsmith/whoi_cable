+/*
+ * WaveSurfaceElevation: free-surface elevation (m, positive up) at horizontal
+ * position y, consistent with WaveSurfaceVelocity (d eta/dt = surface velocity).
+ * Added for the free-floating surface buoy option (surface problem + morison).
+ */
+double WaveSurfaceElevation (double t, double y)
+{
+   double  factor;
+   double  eta = 0.0;
+   double  om, k;
+   int     i;
+
+   if (problem -> dynstat)
+      return 0.0;
+
+   if (analysis -> ramp_time && t < analysis -> ramp_time)
+      factor = t / analysis -> ramp_time;
+   else
+      factor = 1.0;
+
+   if (environment -> input_type == Regular) {
+      for (i = 0 ; i < environment -> num_components [2] ; i++) {
+         k  = environment -> k [2][i];
+         om = environment -> omega [2][i];
+         eta += factor*environment -> amplitude [2][i]
+                *cos(k*y - om*t - environment -> phase [2][i]);
+      }
+   }
+   else if (environment -> input_type == Random) {
+      if (!initialized_random)
+         InitializeRandom ( );
+
+      if (environment -> amplitude [2][0]) {
+         om = om_0;
+         for (i = 0 ; i < nfreq ; i++) {
+            eta += factor*rand_a [i][2]*cos(rand_k [i]*y - om*t - rand_phi [i]);
+            om += d_om;
+         }
+      }
+   }
+
+   return eta;
+}
